{
  "name": "aims",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build --dotenv .env",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "cloudflare:config": "node scripts/render-cloudflare-config.mjs",
    "deploy:cloudflare": "pnpm run verify:cloudflare-deploy && pnpm exec wrangler deploy --config .wrangler.generated.jsonc",
    "preflight:cloudflare": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "verify:cloudflare-deploy": "pnpm run preflight:cloudflare && pnpm run cloudflare:config && pnpm run build:cloudflare && pnpm exec wrangler deploy --dry-run --outdir .output/wrangler-dry-run --config .wrangler.generated.jsonc",
    "dev": "VITE_HMR_PORT=24680 nuxt dev --dotenv .env.dev --port 3002",
    "import:product-version-bindings": "node scripts/import_product_version_bindings.mjs",
    "preview": "nuxt preview",
    "preview:cloudflare": "pnpm run cloudflare:config && pnpm run build:cloudflare && pnpm exec wrangler dev --config .wrangler.generated.jsonc",
    "postinstall": "nuxt prepare",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "seed:product-center-demo": "node scripts/seed_product_center_demo.mjs",
    "seed:product-center-demo-sql": "node scripts/seed_product_center_demo_sql.mjs"
  },
  "dependencies": {
    "@hzy/foundation": "workspace:*",
    "@formkit/drag-and-drop": "^0.5.3",
    "@iconify-json/lucide": "^1.2.71",
    "@iconify-json/simple-icons": "^1.2.55",
    "@nuxt/ui": "^4.1.0",
    "@pinia/nuxt": "^0.11.3",
    "@vueuse/nuxt": "^13.9.0",
    "ali-oss": "^6.23.0",
    "date-fns": "^4.1.0",
    "echarts": "^6.1.0",
    "marked": "^17.0.5",
    "nuxt": "~4.4.8",
    "pinia": "^3.0.4",
    "pinyin-pro": "^3.28.0",
    "zod": "^4.1.12",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@types/node": "^24.10.0",
    "eslint": "^9.38.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.1.2",
    "wrangler": "4.110.0"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.18.0 <25"
  }
}
