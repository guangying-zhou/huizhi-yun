{
  "appCode": "codocs",
  "appName": "汇智云文档",
  "appType": "business",
  "description": "协作文档、知识库、项目文档、部门文档、文档审阅与发布。",
  "icon": "i-lucide-files",
  "entry": {
    "web": "/",
    "apiBase": "/api/v1/codocs"
  },
  "runtimeRequirements": {
    "requiresSdk": true,
    "supportsCustomerHosted": true,
    "supportsManagedControlPlane": false
  },
  "compatibility": {
    "minControlPlaneVersion": "0.1.0",
    "minSdkVersion": "0.1.0"
  },
  "resources": [
    {
      "code": "documents",
      "name": "文档中心",
      "description": "个人文档、共享文档、收藏、回收站与通用文档操作",
      "actions": [
        "view",
        "create",
        "edit",
        "delete",
        "export",
        "admin"
      ],
      "sortOrder": 10
    },
    {
      "code": "projects",
      "name": "项目文档",
      "description": "项目组文档、代码库文档、需求与缺陷关联文档",
      "actions": [
        "view",
        "create",
        "edit",
        "export",
        "admin"
      ],
      "sortOrder": 20
    },
    {
      "code": "departments",
      "name": "部门文档",
      "description": "部门协同文档、会议记录、周报、部门文件柜",
      "actions": [
        "view",
        "create",
        "edit",
        "export",
        "admin"
      ],
      "sortOrder": 30
    },
    {
      "code": "company",
      "name": "组织资产",
      "description": "公司制度、公告、法务合规、技术规范、产品资料与知识库",
      "actions": ["view", "create", "edit", "publish", "export", "admin"],
      "sortOrder": 40
    },
    {
      "code": "reviews",
      "name": "审阅中心",
      "description": "Workflow 发文审批及归档、盖章、发送、接收执行",
      "actions": [
        "view",
        "submit",
        "approve",
        "archive",
        "admin"
      ],
      "sortOrder": 50
    },
    {
      "code": "info",
      "name": "资讯中心",
      "description": "前沿资讯、推荐文章、资讯书签管理",
      "actions": [
        "view",
        "edit",
        "admin"
      ],
      "sortOrder": 60
    },
    {
      "code": "admin",
      "name": "系统管理",
      "description": "图片清理、归档治理等应用后台能力",
      "actions": [
        "view",
        "admin"
      ],
      "sortOrder": 90
    },
    {
      "code": "help",
      "name": "使用指南",
      "description": "Markdown 教程、Mermaid 语法",
      "actions": [
        "view"
      ],
      "sortOrder": 100
    },
    {
      "code": "product-document",
      "name": "产品文档服务读取",
      "description": "由受信 AIMS 产品文档命令触发，逐文档重新校验 Codocs ACL；不授予产品成员正文权限",
      "actions": [
        "read",
        "create"
      ],
      "sortOrder": 190
    }
  ],
  "recommendedRoles": [
    {
      "code": "codocs:viewer",
      "name": "Codocs 只读",
      "description": "可进入 Codocs 并查看被授权的文档资源",
      "suggestedPermissions": [
        "codocs:documents:view",
        "codocs:projects:view",
        "codocs:departments:view",
        "codocs:company:view",
        "codocs:reviews:view",
        "codocs:info:view",
        "codocs:help:view"
      ]
    },
    {
      "code": "codocs:editor",
      "name": "Codocs 编辑",
      "description": "可创建、编辑被授权范围内的文档",
      "suggestedPermissions": [
        "codocs:documents:create",
        "codocs:documents:edit",
        "codocs:projects:create",
        "codocs:projects:edit",
        "codocs:departments:create",
        "codocs:departments:edit",
        "codocs:reviews:submit"
      ]
    },
    {
      "code": "codocs:publisher",
      "name": "Codocs 发布审阅",
      "description": "可处理组织资产发布与审阅归档流程",
      "suggestedPermissions": [
        "codocs:departments:export",
        "codocs:company:publish",
        "codocs:reviews:approve",
        "codocs:reviews:archive"
      ]
    },
    {
      "code": "codocs:records_manager",
      "name": "Codocs 档案管理员",
      "description": "治理企业档案、项目档案、部门档案和审阅归档，不包含应用全局配置",
      "suggestedPermissions": [
        "codocs:documents:view",
        "codocs:documents:export",
        "codocs:projects:view",
        "codocs:projects:export",
        "codocs:departments:view",
        "codocs:departments:export",
        "codocs:company:view",
        "codocs:reviews:view",
        "codocs:reviews:archive",
        "codocs:info:view"
      ]
    },
    {
      "code": "codocs:space_admin",
      "name": "Codocs 空间管理员",
      "description": "管理文档空间、项目文档、部门文档、组织资产和资讯空间，不包含应用后台配置",
      "suggestedPermissions": [
        "codocs:documents:admin",
        "codocs:projects:admin",
        "codocs:departments:admin",
        "codocs:company:admin",
        "codocs:info:admin"
      ]
    },
    {
      "code": "codocs:admin",
      "name": "Codocs 管理员",
      "description": "管理 Codocs 应用配置、发文执行与全局文档能力",
      "suggestedPermissions": [
        "codocs:documents:admin",
        "codocs:documents:delete",
        "codocs:documents:export",
        "codocs:projects:admin",
        "codocs:projects:export",
        "codocs:departments:admin",
        "codocs:departments:export",
        "codocs:company:admin",
        "codocs:company:publish",
        "codocs:company:export",
        "codocs:reviews:admin",
        "codocs:reviews:approve",
        "codocs:reviews:archive",
        "codocs:info:admin",
        "codocs:admin:admin"
      ]
    }
  ],
  "supportedScopes": [
    "tenant:global",
    "department:tree",
    "project:member",
    "subject:self"
  ],
  "capabilitiesRequired": [
    "platform:app-registry"
  ]
}
