# Explicit enterprise OIDC client registration is required; no auth bypass.
HZY_CONSOLE_URL=
# Optional explicit binding for build/config preparation, never inferred from production.
HZY_CONSOLE_WORKER_NAME=
# Required when the Host editor route is enabled. Public origin only; no path,
# credentials, query, or secret. Example: https://codocs-test.example.com
HZY_CODOCS_ORIGIN=
