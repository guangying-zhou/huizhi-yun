{
  "name": "@hzy/foundation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "postinstall": "nuxt prepare",
    "test": "tsx --test \"test/**/*.test.ts\" && node --test test/*.test.mjs",
    "typecheck": "nuxt typecheck"
  },
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./server/utils/*": "./server/utils/*.ts",
    "./shared/utils/*": "./shared/utils/*.ts",
    "./app/types/*": "./app/types/*.ts",
    "./app/stores/*": "./app/stores/*.ts",
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "dependencies": {
    "@hzy/authz-core": "workspace:*",
    "@hzy/platform-adapter-nuxt": "workspace:*",
    "@iconify-json/lucide": "^1.2.71",
    "@iconify-json/simple-icons": "^1.2.55",
    "@nuxt/ui": "^4.1.0",
    "@pinia/nuxt": "^0.11.3",
    "@vueuse/core": "^13.9.0",
    "@vueuse/nuxt": "^13.9.0",
    "ali-oss": "^6.23.0",
    "date-fns": "^4.1.0",
    "h3": "1.15.10",
    "jose": "^6.1.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.2"
  },
  "peerDependencies": {
    "nuxt": "~4.4.8"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@types/ali-oss": "^6.23.1",
    "nuxt": "~4.4.8",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  }
}
