 "integrationDrainTrigger": {
  "question": "INT-001 gap: who actually triggers the Aims/Assets integration drain?",
  "finding": "No scheduled trigger invokes the integration drain in this environment.",
  "evidence": [
   "Only hzy-test-gateway has a cron trigger: 0 16 * * * (daily 00:00 Asia/Shanghai).",
   "deploy/test-env/cloudflare-gateway.mjs dispatches scheduled() by cron value: controller.cron === TEST_POLICY_SYNC_CRON runs policy sync, otherwise runIntegrationDrains.",
   "TEST_POLICY_SYNC_CRON is '0 16 * * *', which equals the only registered cron, so the drain branch is unreachable by schedule.",
   "hzy-test-aims, hzy-test-assets, hzy-test-enterprise, hzy-test-console and hzy-test-drain-coordinator have zero cron triggers.",
   "Deployed gateway version 0866464e declares handlers [\"scheduled\",\"fetch\"] with annotation \"fix(gateway): allow bounded test policy sync completion\"."
  ],
  "remainingPath": "Drain runs request-driven only: app workers call the HZY_DRAIN_COORDINATOR service binding, and the protected /__test/drain/* control endpoints on the gateway.",
  "consequence": "The wrapper keeps drain-dispatch code that no cron can reach; enabling scheduled drains requires registering a second, distinct cron (INT-305)."
 },
