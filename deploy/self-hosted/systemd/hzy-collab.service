[Unit]
Description=HZY self-hosted standalone collab (Codocs v2 realtime, loopback only)
After=network-online.target mysqld.service hzy-data-runtime.service hzy-console.service
Wants=network-online.target
Requires=hzy-data-runtime.service
PartOf=hzy-data-runtime.service
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
Type=simple
User=hzy-collab
Group=hzy-collab
WorkingDirectory=/home/hzy/apps/collab/current
EnvironmentFile=/etc/hzy/collab.env
# The bundle imports dotenv/config; never let it pick up a stray .env from the
# working directory. All configuration comes from /etc/hzy/collab.env.
Environment=DOTENV_CONFIG_PATH=/dev/null
ExecStartPre=/usr/local/bin/node /home/hzy/tools/verify.mjs --dir /home/hzy/apps/collab/current --app collab
ExecStart=/usr/local/bin/node --max-http-header-size=65536 /home/hzy/apps/collab/current/.output/server/index.mjs
# Fails the start when /healthz is not healthy or the listener answers beyond 127.0.0.1.
ExecStartPost=/usr/local/bin/node /home/hzy/tools/health.mjs --app collab
Restart=on-failure
RestartSec=5
TimeoutStartSec=45
TimeoutStopSec=30
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hzy-collab
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# Node/libuv enumerates interfaces using a local AF_NETLINK socket on Linux.
# The listener remains explicitly bound to 127.0.0.1.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
