[Unit]
Description=HZY self-hosted aims node-server
After=network-online.target mysqld.service hzy-data-runtime.service
Wants=network-online.target
Requires=hzy-data-runtime.service
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
Type=simple
User=hzy-aims
Group=hzy-aims
WorkingDirectory=/home/hzy/apps/aims/current
EnvironmentFile=/etc/hzy/aims.env
ExecStartPre=/usr/local/bin/node /home/hzy/tools/verify.mjs --dir /home/hzy/apps/aims/current --app aims
ExecStart=/usr/local/bin/node /home/hzy/apps/aims/current/.output/server/index.mjs
ExecStartPost=/usr/local/bin/node /home/hzy/tools/health.mjs --app aims
Restart=on-failure
RestartSec=5
TimeoutStartSec=45
TimeoutStopSec=30
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hzy-aims
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
