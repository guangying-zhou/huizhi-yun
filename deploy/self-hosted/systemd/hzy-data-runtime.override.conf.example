# Install as /etc/systemd/system/hzy-data-runtime.service.d/g4-config.conf.
# The installer-generated unit already reads /etc/hzy-data-runtime/.env.
[Unit]
After=mysqld.service
Wants=mysqld.service
# Pull stopped dependents back into the Runtime start/restart transaction.
Wants=hzy-console.service hzy-enterprise.service hzy-workflow.service hzy-aims.service hzy-codocs.service hzy-collab.service hzy-tenant-gateway.service

[Service]
EnvironmentFile=/etc/hzy/runtime.env
