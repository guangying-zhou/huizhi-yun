# Copy to /etc/hzy/console.env; root-owned 0600, never commit filled values.
NODE_ENV=production
HOST=127.0.0.1
PORT=31001
HZY_APP_RUN_MODE=prod
HZY_APP_CODE=console
HZY_PLATFORM_ENVIRONMENT=prod
NUXT_APP_BASE_URL=/console/
HZY_DEPLOYMENT_PUBLIC_URL=https://aidcp.wiztek.cn
HZY_APP_HOME_URL=https://aidcp.wiztek.cn/console/
HZY_TENANT_GATEWAY_INTERNAL_TOKEN=REPLACE_SHARED_GATEWAY_TOKEN
HZY_SELF_HOSTED_SERVICE_ORIGINS_JSON=REPLACE_VALIDATED_LOOPBACK_ORIGINS_JSON
HZY_SELF_HOSTED_RUNTIME_ENDPOINT=REPLACE_CANONICAL_RUNTIME_HTTPS_ENDPOINT
HZY_SELF_HOSTED_RUNTIME_DIAL_ORIGIN=http://127.0.0.1:31080
HZY_DATA_ACCESS_MODE=tenant-runtime
HZY_TENANT_RUNTIME_URL=REPLACE_CANONICAL_RUNTIME_HTTPS_ENDPOINT
HZY_TENANT_RUNTIME_TENANT=REPLACE_TENANT_CODE
HZY_TENANT_RUNTIME_DEPLOYMENT=REPLACE_RUNTIME_DEPLOYMENT_CODE
HZY_CONSOLE_URL=https://aidcp.wiztek.cn/console
HZY_CONSOLE_API_URL=https://aidcp.wiztek.cn/console
HZY_CONSOLE_TOKEN_URL=https://aidcp.wiztek.cn/console/oauth/token
HZY_PLATFORM_URL=https://hzy.wiztek.cn
HZY_CONSOLE_ACTIVATION_MODE=private-deployment
HZY_CONSOLE_RUN_MODE=prod
HZY_CONSOLE_TRUST_TENANT_GATEWAY=true
HZY_CONSOLE_BACKGROUND_JOBS_ENABLED=false
# Realtime collaboration runs as the standalone hzy-collab unit (Host -> Gateway /codocs/ws ->
# Collab -> Runtime). Console's embedded Collab must stay disabled: it would run under Console's
# identity, not the collab.runtime service client, and it cannot redeem v2 tickets.
CONSOLE_COLLAB_MODE=disabled
CONSOLE_OIDC_ISSUER=https://aidcp.wiztek.cn/console
OIDC_ENABLE=true
OIDC_ISSUER=REPLACE_UPSTREAM_OIDC_ISSUER
OIDC_AUTHORIZATION_ENDPOINT=REPLACE_UPSTREAM_AUTHORIZATION_URL
OIDC_TOKEN_ENDPOINT=REPLACE_UPSTREAM_TOKEN_URL
OIDC_JWKS_URI=REPLACE_UPSTREAM_JWKS_URL
OIDC_CLIENT_ID=REPLACE_OIDC_CLIENT_ID
OIDC_CLIENT_SECRET=REPLACE_OIDC_CLIENT_SECRET
OIDC_REDIRECT_URI=https://aidcp.wiztek.cn/console/api/auth/oidc-callback
HZY_PLATFORM_TENANT_CODE=REPLACE_TENANT_CODE
HZY_PLATFORM_DEPLOYMENT_CODE=REPLACE_CONSOLE_DEPLOYMENT_CODE
HZY_PLATFORM_SIGNING_KID=REPLACE_PLATFORM_PUBLIC_KEY_ID
# PEM: keep the double quotes. systemd EnvironmentFile drops the backslash of an unquoted \n, which corrupts the key.
HZY_PLATFORM_SIGNING_PUBKEY="REPLACE_PLATFORM_PUBLIC_KEY_PEM_ESCAPED"
HZY_PLATFORM_BUNDLE_CACHE_BACKEND=verified-runtime
HZY_PLATFORM_RUNTIME_ENABLED=true
HZY_PLATFORM_HEARTBEAT_ENABLED=true
HZY_PLATFORM_BUNDLE_REFRESH_ON_BOOT=true
HZY_PLATFORM_AUTH_CLIENT_MATERIALIZE=false
HZY_CONSOLE_PLATFORM_SERVICE_TOKEN=REPLACE_PLATFORM_SERVICE_TOKEN
HZY_CONSOLE_SERVICE_KEY_FILE=/etc/hzy/console-service-key.pem
HZY_WORKFLOW_API_URL=http://127.0.0.1:31003/workflow
# Nuxt runtimeConfig overrides; HZY_/OIDC_ above alone cannot override build defaults.
NUXT_AUTH_OIDC_ISSUER=https://aidcp.wiztek.cn/console
NUXT_AUTH_UPSTREAM_OIDC_ENABLED=true
NUXT_AUTH_UPSTREAM_OIDC_ISSUER=REPLACE_UPSTREAM_OIDC_ISSUER
NUXT_AUTH_UPSTREAM_OIDC_AUTHORIZATION_ENDPOINT=REPLACE_UPSTREAM_AUTHORIZATION_URL
NUXT_AUTH_UPSTREAM_OIDC_TOKEN_ENDPOINT=REPLACE_UPSTREAM_TOKEN_URL
NUXT_AUTH_UPSTREAM_OIDC_JWKS_URI=REPLACE_UPSTREAM_JWKS_URL
NUXT_AUTH_UPSTREAM_OIDC_CLIENT_ID=REPLACE_OIDC_CLIENT_ID
NUXT_AUTH_UPSTREAM_OIDC_CLIENT_SECRET=REPLACE_OIDC_CLIENT_SECRET
NUXT_AUTH_UPSTREAM_OIDC_REDIRECT_URI=https://aidcp.wiztek.cn/console/api/auth/oidc-callback
NUXT_PLATFORM_ACTIVATION_MODE=private-deployment
NUXT_PLATFORM_BASE_URL=https://hzy.wiztek.cn
NUXT_PLATFORM_TENANT_CODE=REPLACE_TENANT_CODE
NUXT_PLATFORM_DEPLOYMENT_CODE=REPLACE_CONSOLE_DEPLOYMENT_CODE
NUXT_PLATFORM_ENVIRONMENT=prod
NUXT_PLATFORM_PLATFORM_SERVICE_TOKEN=REPLACE_PLATFORM_SERVICE_TOKEN
NUXT_PLATFORM_SIGNING_KID=REPLACE_PLATFORM_PUBLIC_KEY_ID
NUXT_PLATFORM_SIGNING_PUBKEY="REPLACE_PLATFORM_PUBLIC_KEY_PEM_ESCAPED"
NUXT_PLATFORM_RUNTIME_ENABLED=true
NUXT_PLATFORM_HEARTBEAT_ENABLED=true
NUXT_PLATFORM_BUNDLE_REFRESH_ON_BOOT=true
NUXT_PLATFORM_AUTH_CLIENT_MATERIALIZE=false
NUXT_CONSOLE_RUNTIME_ACTIVATION_MODE=private-deployment
NUXT_CONSOLE_RUNTIME_RUN_MODE=prod
NUXT_CONSOLE_RUNTIME_BACKGROUND_JOBS_ENABLED=false
NUXT_HZY_WORKFLOW_API_URL=http://127.0.0.1:31003/workflow
NUXT_PUBLIC_DEPLOYMENT_PUBLIC_URL=https://aidcp.wiztek.cn
NUXT_PUBLIC_APP_HOME_URL=https://aidcp.wiztek.cn/console/
NUXT_PUBLIC_SSO_OIDC_ENABLE=true
# Auth cookies must be host-only: without this the cookie Domain becomes the last two labels of the host (.wiztek.cn) and session cookies
# are sent to every sibling site (and accumulate into HTTP 431).
HZY_AUTH_COOKIE_HOST_ONLY=true
