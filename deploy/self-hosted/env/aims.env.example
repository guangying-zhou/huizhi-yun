# Copy to /etc/hzy/aims.env; root-owned 0600, never commit filled values.
NODE_ENV=production
HOST=127.0.0.1
PORT=31004
HZY_APP_RUN_MODE=prod
HZY_APP_CODE=aims
HZY_PLATFORM_ENVIRONMENT=prod
NUXT_APP_BASE_URL=/aims/
HZY_DEPLOYMENT_PUBLIC_URL=https://aidcp.wiztek.cn
HZY_APP_HOME_URL=https://aidcp.wiztek.cn/aims/
HZY_TENANT_GATEWAY_INTERNAL_TOKEN=REPLACE_SHARED_GATEWAY_TOKEN
HZY_SELF_HOSTED_SERVICE_ORIGINS_JSON=REPLACE_VALIDATED_LOOPBACK_ORIGINS_JSON
HZY_SELF_HOSTED_RUNTIME_ENDPOINT=REPLACE_CANONICAL_RUNTIME_HTTPS_ENDPOINT
HZY_SELF_HOSTED_RUNTIME_DIAL_ORIGIN=http://127.0.0.1:31080
HZY_DATA_ACCESS_MODE=tenant-runtime
HZY_TENANT_RUNTIME_URL=REPLACE_CANONICAL_RUNTIME_HTTPS_ENDPOINT
HZY_TENANT_RUNTIME_TENANT=REPLACE_TENANT_CODE
HZY_TENANT_RUNTIME_DEPLOYMENT=REPLACE_RUNTIME_DEPLOYMENT_CODE
HZY_CONSOLE_URL=https://aidcp.wiztek.cn/console
HZY_CONSOLE_API_URL=https://aidcp.wiztek.cn/console
HZY_CONSOLE_TOKEN_URL=https://aidcp.wiztek.cn/console/oauth/token
HZY_PLATFORM_URL=https://platform.wiztek.cn
HZY_AIMS_SCHEDULER_ONLY=true
HZY_AIMS_DATA_ACCESS_MODE=tenant-runtime
HZY_AIMS_SERVICE_CLIENT_ID=aims.runtime
HZY_AIMS_SERVICE_CLIENT_SECRET=REPLACE_AIMS_SERVICE_CLIENT_SECRET
HZY_WORKFLOW_API_URL=http://127.0.0.1:31003/workflow
# Event-less company-summary delivery: same Codocs deployment as gateway.json.
HZY_CODOCS_TARGET_DEPLOYMENT=REPLACE_CODOCS_DEPLOYMENT_CODE
HZY_CODOCS_SERVICE_BASE_URL=http://127.0.0.1:31005/codocs
# Nuxt runtimeConfig overrides.
NUXT_HZY_DATA_ACCESS_MODE=tenant-runtime
NUXT_HZY_SCHEDULER_ONLY=true
NUXT_HZY_TENANT_RUNTIME_ENDPOINT=REPLACE_CANONICAL_RUNTIME_HTTPS_ENDPOINT
NUXT_HZY_TENANT_RUNTIME_TENANT=REPLACE_TENANT_CODE
NUXT_HZY_TENANT_RUNTIME_DEPLOYMENT=REPLACE_RUNTIME_DEPLOYMENT_CODE
NUXT_HZY_CONSOLE_RUNTIME_CONSOLE_API_URL=https://aidcp.wiztek.cn/console
NUXT_HZY_CONSOLE_RUNTIME_ENABLED=true
NUXT_HZY_DIRECTORY_CONSOLE_API_URL=https://aidcp.wiztek.cn/console
NUXT_HZY_INTEGRATION_CONSOLE_API_URL=https://aidcp.wiztek.cn/console
NUXT_HZY_SERVICE_CLIENT_CLIENT_ID=aims.runtime
NUXT_HZY_SERVICE_CLIENT_CLIENT_SECRET=REPLACE_AIMS_SERVICE_CLIENT_SECRET
NUXT_HZY_SERVICE_CLIENT_TOKEN_URL=https://aidcp.wiztek.cn/console/oauth/token
NUXT_PUBLIC_DEPLOYMENT_PUBLIC_URL=https://aidcp.wiztek.cn
NUXT_PUBLIC_APP_HOME_URL=https://aidcp.wiztek.cn/aims/
