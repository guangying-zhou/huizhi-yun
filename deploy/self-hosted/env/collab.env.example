# Copy to /etc/hzy/collab.env; root-owned 0600, never commit filled values.
# Standalone Collab for Codocs v2 realtime editing (shared personal documents).
# The unit is installed but NOT enabled until the go-live approvals for the
# collab.runtime registration, Runtime schema/flags and snapshot bucket are done.
# Collab holds no database, OSS, Vault or OIDC-signing material: snapshot bytes
# travel through the Runtime, and identity is the collab.runtime service client.
NODE_ENV=production
HZY_APP_RUN_MODE=prod
HZY_PLATFORM_ENVIRONMENT=prod

# Loopback listener only. Must equal apps.collab.origin in /etc/hzy-gateway/gateway.json
# and PORTS.collab in release-lib.mjs. health.mjs fails the start if any other
# local address answers on this port.
COLLAB_RUNTIME_MODE=standalone
COLLAB_PROVIDER=hocuspocus
COLLAB_ADDRESS=127.0.0.1
COLLAB_PORT=31007
COLLAB_PUBLIC_BASE_PATH=/codocs/
COLLAB_STOP_ON_SIGNALS=true
# Single process: no Redis.
COLLAB_REDIS_DISABLED=true

# Runtime access (G-10 mapping). The canonical registered endpoint identifies the
# Runtime; the process dials the local loopback origin. Collab uses a plain fetch and
# reads only COLLAB_CODOCS_RUNTIME_URL, so that key carries the DIAL origin (the same
# value as HZY_SELF_HOSTED_RUNTIME_DIAL_ORIGIN in codocs.env). The canonical endpoint
# below is not read by Collab; it is kept so the two never drift apart unreviewed.
# HZY_SELF_HOSTED_RUNTIME_ENDPOINT=REPLACE_CANONICAL_RUNTIME_HTTPS_ENDPOINT
COLLAB_CODOCS_RUNTIME_URL=http://127.0.0.1:31080
# Never set COLLAB_CODOCS_RUNTIME_TOKEN / HZY_*_RUNTIME_TOKEN (no static Runtime token),
# and leave COLLABORATION_AUTH_SECRET unset: the legacy HMAC (v1) socket path stays closed
# and only Host-issued one-time v2 tickets connect.

# Feature flag. true = redeem `v2.<ticket>` tokens, load/store Runtime snapshots.
COLLAB_V2_ENABLED=true
# Lease renewal interval (Runtime session lease is 5 minutes for personal documents).
COLLAB_V2_RENEW_INTERVAL_MS=45000

# Service identity: the Console-registered `collab.runtime` client. Exact grants
# (aud=data-runtime): codocs:collaboration-snapshots:read and :publish only.
# The secret is enrolled through the formal credential flow and lives only here.
COLLAB_SERVICE_CLIENT_ID=collab.runtime
COLLAB_SERVICE_CLIENT_SECRET=REPLACE_COLLAB_SERVICE_CLIENT_SECRET
# This site's own Console token endpoint, the same URL Codocs/Enterprise use
# (HZY_CONSOLE_TOKEN_URL). Confirm during the pre-enable check that the Gateway
# allows this path for the collab.runtime client from the host itself.
COLLAB_CONSOLE_TOKEN_URL=https://aidcp.wiztek.cn/console/oauth/token
