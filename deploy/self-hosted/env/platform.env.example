# ARCHIVED (2026-09-29, Platform plan §8c): production control plane is the shared https://hzy.wiztek.cn Platform; this host no longer runs Platform. Kept for reference only — do not install.
# Copy to /etc/hzy/platform.env; root-owned 0600, never commit filled values.
# Build does not embed secrets. Nuxt runtimeConfig reads NUXT_* at process start.
NODE_ENV=production
HOST=127.0.0.1
PORT=31006
HZY_APP_RUN_MODE=prod
HZY_APP_CODE=platform
HZY_PLATFORM_ENVIRONMENT=prod
NUXT_APP_BASE_URL=/
HZY_DEPLOYMENT_PUBLIC_URL=https://platform.wiztek.cn
HZY_APP_HOME_URL=https://platform.wiztek.cn/
HZY_PLATFORM_URL=https://platform.wiztek.cn
PLATFORM_SERVICE_URL=https://platform.wiztek.cn
NUXT_PUBLIC_SERVICE_URL=https://platform.wiztek.cn
NUXT_PUBLIC_PLATFORM_STAGE=production
NUXT_DB_HOST=127.0.0.1
NUXT_DB_PORT=3306
NUXT_DB_NAME=hzy_platform
NUXT_DB_USER=REPLACE_PLATFORM_DB_USER
NUXT_DB_PASSWORD=REPLACE_PLATFORM_DB_PASSWORD
NUXT_DB_CONNECTION_LIMIT=10
# These apply to runtimeConfig.security, not the old build-time PLATFORM_* defaults.
NUXT_SECURITY_ENABLE_OPS_RBAC=true
NUXT_SECURITY_ALLOW_OPS_UID_FALLBACK=false
NUXT_SECURITY_ALLOW_LEGACY_ADMIN_API=false
NUXT_SECURITY_OPS_UIDS=REPLACE_APPROVED_OPS_UIDS
NUXT_SECURITY_OPS_BOOTSTRAP_UIDS=REPLACE_APPROVED_BOOTSTRAP_OPS_UIDS
# The signer reads this path directly at runtime; the key itself is outside Git.
HZY_PLATFORM_SIGNING_PRIVATE_KEY=/etc/hzy/platform-signing/REPLACE_KID.pem
# Two distinct credentials for Gateway registry and Console, separated by comma.
# Platform middleware reads this process variable directly at runtime.
PLATFORM_INTERNAL_SERVICE_TOKENS=REPLACE_GATEWAY_REGISTRY_TOKEN,REPLACE_CONSOLE_PLATFORM_TOKEN
NUXT_SECURITY_INTERNAL_SERVICE_TOKENS=REPLACE_GATEWAY_REGISTRY_TOKEN,REPLACE_CONSOLE_PLATFORM_TOKEN
NUXT_IDENTITY_PROVIDER_MODE=oidc-first
NUXT_AUTH_ACTIVATION_BASE_URL=https://platform.wiztek.cn
NUXT_PUBLIC_WECOM_ADMIN_LOGIN_ENABLED=true
NUXT_AUTH_WECOM_CORPID=REPLACE_WECOM_CORPID
NUXT_AUTH_WECOM_CORPSECRET=REPLACE_WECOM_CORPSECRET
NUXT_AUTH_WECOM_AGENTID=REPLACE_WECOM_AGENTID
NUXT_AUTH_WECOM_REDIRECT_URI=https://platform.wiztek.cn/api/platform/auth/wecom/callback
NUXT_AUTH_WECOM_ALLOWED_USERIDS=REPLACE_APPROVED_WECOM_UIDS
NUXT_AUTH_WECOM_ALLOW_ALL=false
# Optional. Egress WeCom server API calls through the gitlab host proxy so WeCom sees the
# trusted IP 8.130.81.31 (this server's public egress IP is not fixed). Only
# https://qyapi.weixin.qq.com (default) or http://<tailnet 100.64.0.0/10 IP>:<port> without
# path/query/credentials is accepted; anything else fails closed (platform_wecom_api_base_invalid).
# Requires the approved nginx proxy in platform-ingress/wecom-egress-proxy.nginx.conf.example.
#NUXT_AUTH_WECOM_API_BASE=http://100.98.120.65:8790
NUXT_POLICY_ENVELOPE_ISSUER=https://platform.wiztek.cn
# Set only if the Runtime release channel is enabled.
HZY_DATA_RUNTIME_RELEASE_PUBLIC_KEY_PEM=REPLACE_APPROVED_RUNTIME_RELEASE_PUBLIC_KEY_PEM
NUXT_DATA_RUNTIME_RELEASE_RELEASE_PUBLIC_KEY_PEM=REPLACE_APPROVED_RUNTIME_RELEASE_PUBLIC_KEY_PEM
