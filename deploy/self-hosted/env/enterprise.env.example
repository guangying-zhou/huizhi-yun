# Copy to /etc/hzy/enterprise.env; root-owned 0600, never commit filled values.
NODE_ENV=production
HOST=127.0.0.1
PORT=31002
HZY_APP_RUN_MODE=prod
HZY_APP_CODE=enterprise
HZY_PLATFORM_ENVIRONMENT=prod
# The Enterprise Host serves /enterprise, /aims, /assets and /codocs, so app.baseURL must stay '/' (enterprise/nuxt.config.ts); the
# pilot build already puts assets under /enterprise/_nuxt/. '/enterprise/' here doubles the prefix (/enterprise/enterprise/_nuxt/...).
NUXT_APP_BASE_URL=/
HZY_DEPLOYMENT_PUBLIC_URL=https://aidcp.wiztek.cn
HZY_APP_HOME_URL=https://aidcp.wiztek.cn/enterprise/
HZY_TENANT_GATEWAY_INTERNAL_TOKEN=REPLACE_SHARED_GATEWAY_TOKEN
HZY_SELF_HOSTED_SERVICE_ORIGINS_JSON=REPLACE_VALIDATED_LOOPBACK_ORIGINS_JSON
HZY_SELF_HOSTED_RUNTIME_ENDPOINT=REPLACE_CANONICAL_RUNTIME_HTTPS_ENDPOINT
HZY_SELF_HOSTED_RUNTIME_DIAL_ORIGIN=http://127.0.0.1:31080
HZY_DATA_ACCESS_MODE=tenant-runtime
HZY_TENANT_RUNTIME_URL=REPLACE_CANONICAL_RUNTIME_HTTPS_ENDPOINT
HZY_TENANT_RUNTIME_TENANT=REPLACE_TENANT_CODE
HZY_TENANT_RUNTIME_DEPLOYMENT=REPLACE_RUNTIME_DEPLOYMENT_CODE
HZY_CONSOLE_URL=https://aidcp.wiztek.cn/console
HZY_CONSOLE_API_URL=https://aidcp.wiztek.cn/console
HZY_CONSOLE_TOKEN_URL=https://aidcp.wiztek.cn/console/oauth/token
HZY_PLATFORM_URL=https://hzy.wiztek.cn
HZY_ENTERPRISE_PILOT=true
HZY_ENTERPRISE_HOST_WORKFLOW_ENABLED=true
HZY_ENTERPRISE_WORKFLOW_ORIGIN=http://127.0.0.1:31003
HZY_ENTERPRISE_VERIFIED_POLICY_ENABLED=true
HZY_ENTERPRISE_POLICY_ISSUER=https://hzy.wiztek.cn
HZY_ENTERPRISE_POLICY_KEY_ID=REPLACE_PLATFORM_PUBLIC_KEY_ID
# PEM: keep the double quotes. systemd EnvironmentFile drops the backslash of an unquoted \n, which corrupts the key.
HZY_ENTERPRISE_POLICY_PUBLIC_KEY="REPLACE_PLATFORM_PUBLIC_KEY_PEM_ESCAPED"
HZY_ENTERPRISE_POLICY_MAX_AGE_MS=3600000
# Codocs v2 shared-personal-document collaboration. BOTH server flags default false and are
# switched on together, only after the go-live approvals: Runtime schema install, Runtime
# apps.codocs.snapshotV2Enabled + collaborationV2Enabled + deploymentBindings.collab,
# collab.runtime registration/grant verify/token probe, snapshot-bucket proof, and the
# standalone hzy-collab unit + /codocs/ws Gateway route. The exact value "true" enables a flag.
# Collaboration requires the snapshot flag (the ticket route checks both).
HZY_ENTERPRISE_CODOCS_SNAPSHOT_V2=false
HZY_ENTERPRISE_CODOCS_COLLABORATION_V2=false
# The page switch is a public runtimeConfig value that nuxt.config.ts derives from the two
# flags at BUILD time (release builds never set them), so the running server needs this
# explicit override. Keep it equal to the two flags above: false until enabling, then true.
NUXT_PUBLIC_CODOCS_COLLABORATION_V2=false
# Department document collaboration is a THIRD, separate switch on top of the two above. It
# needs the personal collaboration chain already accepted, Runtime
# apps.codocs.departmentCollaborationV2Enabled, and the Codocs migration
# codocs/docs/migrations/20260929_department_collaboration.sql on the target Codocs database.
# Off, department documents keep their current (non-collaborative) behaviour. The page switch
# below is the same kind of build-time-derived public value: keep it equal to this flag
# (and false whenever either flag above is false).
HZY_ENTERPRISE_CODOCS_DEPARTMENT_COLLABORATION_V2=false
NUXT_PUBLIC_CODOCS_DEPARTMENT_COLLABORATION_V2=false
HZY_ENTERPRISE_OIDC_REDIRECT_URI=https://aidcp.wiztek.cn/enterprise/api/auth/oidc-callback
HZY_ENTERPRISE_LOGOUT_REDIRECT_URI=https://aidcp.wiztek.cn/enterprise/login
NUXT_PUBLIC_CODOCS_URL=https://aidcp.wiztek.cn/codocs
HZY_SERVICE_CLIENT_ID=enterprise.runtime
HZY_SERVICE_CLIENT_SECRET=REPLACE_ENTERPRISE_SERVICE_CLIENT_SECRET
# Nuxt runtimeConfig overrides, including server-only policy material.
NUXT_VERIFIED_POLICY_ENABLED=true
NUXT_VERIFIED_POLICY_ISSUER=https://hzy.wiztek.cn
NUXT_VERIFIED_POLICY_KID=REPLACE_PLATFORM_PUBLIC_KEY_ID
NUXT_VERIFIED_POLICY_PUBLIC_KEY="REPLACE_PLATFORM_PUBLIC_KEY_PEM_ESCAPED"
NUXT_VERIFIED_POLICY_ENVIRONMENT=prod
NUXT_VERIFIED_POLICY_MAX_AGE_MS=3600000
NUXT_HZY_WORKFLOW_API_URL=http://127.0.0.1:31003/workflow
NUXT_HZY_CONSOLE_OIDC_REDIRECT_URI=https://aidcp.wiztek.cn/enterprise/api/auth/oidc-callback
NUXT_HZY_CONSOLE_OIDC_LOGOUT_REDIRECT_URI=https://aidcp.wiztek.cn/enterprise/login
NUXT_PUBLIC_RUM_ENABLED=false

# 对象存储单次请求超时（毫秒）。缺省 8000 即可，自托管不要设置；仅在到对象存储延迟异常大的开发环境覆盖，
# 合法范围 1000-120000，非法值回退缺省并记录固定码 codocs_oss_timeout_invalid。
# HZY_CODOCS_OSS_TIMEOUT_MS=8000
# Auth cookies must be host-only: without this the cookie Domain becomes the last two labels of the host (.wiztek.cn) and session cookies
# are sent to every sibling site (and accumulate into HTTP 431).
HZY_AUTH_COOKIE_HOST_ONLY=true
