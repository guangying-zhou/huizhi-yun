# Installed as /etc/hzy/runtime.env (root 0600). The existing Runtime unit reads
# this after /etc/hzy-data-runtime/.env via the G-4 systemd drop-in.
# Runtime process user must be able to read the owner-only config.json.
HZY_DATA_RUNTIME_CONFIG=/etc/hzy-data-runtime/config.json
HZY_DATA_RUNTIME_CONFIG_DIR=/etc/hzy-data-runtime

# Codocs collaboration switches are NOT environment variables: they live in the owner-only
# config.json above under apps.codocs and all default to false:
#   snapshotV2Enabled, collaborationV2Enabled          personal shared-document collaboration
#   departmentCollaborationV2Enabled                   department documents (needs both above,
#                                                      the 20260929 Codocs migration and no new
#                                                      capability or grant)
# Enable them one at a time, each after its own approval (deploy/self-hosted/README.md).
