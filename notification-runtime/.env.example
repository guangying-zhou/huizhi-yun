HZY_NOTIFICATION_RUNTIME_HOST=0.0.0.0
HZY_NOTIFICATION_RUNTIME_PORT=18081
HZY_NOTIFICATION_RUNTIME_INSTALL_DIR=/opt/hzy/notification-runtime
HZY_NOTIFICATION_RUNTIME_TENANT=default
HZY_NOTIFICATION_RUNTIME_DEPLOYMENT=local

# Incoming auth from Cloudflare apps / Foundation sendNotification().
HZY_NOTIFICATION_RUNTIME_AUTH_MODE=jwt
HZY_NOTIFICATION_RUNTIME_AUDIENCE=notification-runtime
HZY_NOTIFICATION_RUNTIME_JWT_ISSUER=http://localhost:3000
HZY_NOTIFICATION_RUNTIME_JWKS_URL=http://localhost:3000/.well-known/jwks.json

# Console service client used by notification-runtime to read Integration/Vault.
HZY_CONSOLE_API_URL=http://localhost:3000
HZY_CONSOLE_TOKEN_URL=http://localhost:3000/oauth/token
HZY_NOTIFICATION_RUNTIME_DATA_RUNTIME_URL=http://localhost:18080
HZY_NOTIFICATION_RUNTIME_CLIENT_ID=notification-runtime
HZY_NOTIFICATION_RUNTIME_CLIENT_SECRET=change-me

# Runtime-owned durable delivery ledger. SQLite is the single-instance default;
# keep it on local disk (not NFS/shared storage). There is no in-memory fallback.
HZY_NOTIFICATION_RUNTIME_STORE=sqlite
HZY_NOTIFICATION_RUNTIME_SQLITE_PATH=/opt/hzy/notification-runtime/data/delivery.db
HZY_NOTIFICATION_RUNTIME_DELIVERY_LEASE_MS=120000

# Optional multi-instance MySQL mode:
# HZY_NOTIFICATION_RUNTIME_STORE=mysql
# HZY_NOTIFICATION_RUNTIME_DB_HOST=127.0.0.1
# HZY_NOTIFICATION_RUNTIME_DB_PORT=3306
# HZY_NOTIFICATION_RUNTIME_DB_USER=hzy_notification_runtime
# HZY_NOTIFICATION_RUNTIME_DB_PASSWORD=change-me
# HZY_NOTIFICATION_RUNTIME_DB_NAME=hzy_notification_runtime
# HZY_NOTIFICATION_RUNTIME_DB_CONNECTION_LIMIT=5

HZY_NOTIFICATION_RUNTIME_PACKAGE_BASE_URL=https://downloads.huizhi.yun/packages/hzy-notification-runtime
